	[ -n "$ctx_attached" ] && { printf 'Attached files:\n'; cat "$tmp.attach"; }
} | run_harness >"$tmp" 2>"$tmp.err" &
pid=$!
idle=0
(
	while [ ! -e "$tmp.stop" ]; do
		sleep 1
		if tool_busy; then
			idle=0
			continue
		fi
		size=$(arrived)
		if [ "$size" != "$wsize" ]; then
			wsize=$size
			idle=0
			continue
		fi
		idle=$((idle + 1))
		if [ "$idle" -ge "$max" ]; then
