#!/bin/sh
# terat - ask an AI one question and print the answer.
#   terat "why did that build fail?"      terat @shot.png "what is this?"
#   terat claude "why?"                   terat set agent claude
#   terat acp                             JSON-RPC on stdin, for an editor
#   terat --version

thread=${TERAT_THREAD:-${HOME:-.}/.terat/thread.$PPID}
terat_version=1.0.0
max=${TERAT_MAX:-180}
tmp_base=${TMPDIR:-/tmp}
[ -d "$tmp_base" ] && [ -w "$tmp_base" ] || tmp_base=/tmp
tmp=$tmp_base/terat.$$
now_ms() {
	_terat_t=$(date +%s%N 2>/dev/null)
	case $_terat_t in
	''|*[!0-9]*) _terat_t=$(date +%s 2>/dev/null)
		case $_terat_t in ''|*[!0-9]*) _terat_t=0 ;; esac
		_terat_t=$((_terat_t * 1000)) ;;
	*) _terat_t=$((_terat_t / 1000000)) ;;
	esac
	printf '%s' "$_terat_t"
}
started=$(now_ms)
mkdir -p "${thread%/*}" 2>/dev/null

terat_cfg=${TERAT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/terat/settings}
agents='pi claude codex opencode grok dsh'

terat_self=$0
case $terat_self in
*/*) terat_dir=${terat_self%/*} ;;
*) terat_dir=. ;;
esac
if [ -r "$terat_dir/.env" ] && [ -z "${TERAT_OTLP:-}" ]; then
	while IFS='=' read -r env_k env_v; do
		case $env_k in
		TERAT_OTLP | TERAT_OTLP_KEY) ;;
		*) continue ;;
		esac
		env_v=${env_v%\"}
		env_v=${env_v#\"}
		env_v=${env_v%\'}
		env_v=${env_v#\'}
		[ -n "$env_v" ] || continue
		export "$env_k=$env_v"
	done <"$terat_dir/.env"
	unset env_k env_v
fi

agent_cmd() {
	case $1 in
	pi) echo 'pi -p --mode json' ;;
	claude) echo 'claude -p' ;;
	codex) echo 'codex exec --skip-git-repo-check' ;;
	opencode) echo 'opencode run' ;;
	grok) echo 'grok -p {}' ;;
	dsh) echo 'dsh --profile headless {}' ;;
	*) return 1 ;;
	esac
}

agent_name() {
	case $1 in
	pi) echo Pi ;;
	claude) echo Claude ;;
	codex) echo Codex ;;
	opencode) echo opencode ;;
	grok) echo Grok ;;
	dsh) echo dsh ;;
	*) return 1 ;;
	esac
}

is_agent() { agent_cmd "$1" >/dev/null 2>&1; }

cfg_get() {
	[ -f "$terat_cfg" ] || return 0
	awk -v k="$1" '
		index($0, k "=") == 1 { v = substr($0, length(k) + 2) }
		END { if (v != "") print v }
	' "$terat_cfg"
}

cfg_set() {
	mkdir -p "${terat_cfg%/*}" 2>/dev/null
	if [ -f "$terat_cfg" ]; then
		cfg_in=$terat_cfg
	else
		cfg_in=/dev/null
	fi
	awk -v k="$1" -v v="$2" '
		index($0, k "=") == 1 { next }
		{ print }
		END { print k "=" v }
	' "$cfg_in" >"$terat_cfg.new" || return 1
	mv "$terat_cfg.new" "$terat_cfg" || return 1
	chmod 600 "$terat_cfg" 2>/dev/null
	return 0
}

case ${1:-} in
set)
	shift
	key=${1:-}
	[ "$#" -gt 0 ] && shift
	val=$*
	case $key in
	agent)
		if [ -z "$val" ]; then
			cur=$(cfg_get agent)
			printf '%s\n' "${cur:-pi (default)}"
			exit 0
		fi
		if ! is_agent "$val"; then
			printf 'terat: no such agent: %s\n' "$val" >&2
			printf 'terat: try %s\n' "$agents" >&2
			exit 2
		fi
		cfg_set agent "$val" || exit 1
		bin=$(agent_cmd "$val" | awk '{print $1}')
		if command -v "$bin" >/dev/null 2>&1; then
			printf 'agent=%s\n' "$val"
		else
			printf 'agent=%s (but `%s` is not on PATH yet)\n' "$val" "$bin"
		fi
		exit 0 ;;
	url | key | model | trace)
		if [ -z "$val" ]; then
			case $key in
			key)
				if [ -n "$(cfg_get key)" ]; then printf 'key=(set)\n'
				else printf 'key=(unset)\n'
				fi ;;
			trace)
				printf 'trace=%s\n' "$(cfg_get trace | sed 's/^$//')" |
					sed 's/^trace=$/trace=off/'
				;;
			*) printf '%s=%s\n' "$key" "$(cfg_get "$key")" ;;
			esac
			exit 0
		fi
		if [ "$key" = trace ]; then
			case $val in
			on | off) ;;
			'') cur=$(cfg_get trace); printf '%s\n' "${cur:-off}"; exit 0 ;;
			*)
				printf 'terat: trace takes on or off, not: %s\n' "$val" >&2
				exit 2 ;;
			esac
		fi
		cfg_set "$key" "$val" || exit 1
		case $key in key) printf 'key=(set)\n' ;; *) printf '%s=%s\n' "$key" "$val" ;; esac
		exit 0 ;;
	'')
		printf 'terat: set what?\n' >&2
		printf 'terat: set agent %s\n' "$agents" >&2
		printf 'terat: set url <base url>\n' >&2
		printf 'terat: set key <api key>\n' >&2
		printf 'terat: set model <model id>   (terat models shows them)\n' >&2
		printf 'terat: set trace on | off      trace every question\n' >&2
		exit 2 ;;
	*)
		printf 'terat: cannot set: %s\n' "$key" >&2
		printf 'terat: try agent, url, key, model or trace\n' >&2
		exit 2 ;;
	esac ;;
config)
	if [ -f "$terat_cfg" ]; then
		sed 's/^key=.*/key=(set)/' "$terat_cfg"
	else
		printf 'terat: no settings yet; %s does not exist\n' "$terat_cfg"
	fi
	exit 0 ;;
agents)
	printf '%s\n' $agents
	exit 0 ;;
models)
	shift
	url=$(cfg_get url)
	[ -n "$url" ] || { printf 'terat: no endpoint yet; terat set url <url>\n' >&2; exit 2; }
	json=$(curl -s -m 20 "$url/models" 2>/dev/null) ||
		wget -q -T 20 -O - "$url/models" 2>/dev/null || {
		printf 'terat: could not read %s/models\n' "${url%/}" >&2
		exit 1
	}
	[ -n "$json" ] || { printf 'terat: %s/models returned nothing\n' "${url%/}" >&2; exit 1; }
	printf '%s' "$json" | tr -d '\n\r' | awk -v filter="${1:-}" '
	{
		s = $0
		while ((i = index(s, "\"id\":")) > 0) {
			s = substr(s, i + 5)
			sub(/^[ \t]*"/, "", s)
			n = index(s, "\"")
			if (n == 0) break
			id = substr(s, 1, n - 1)
			s = substr(s, n + 1)
			j = index(s, "\"id\":")
			body = (j > 0) ? substr(s, 1, j - 1) : s
			s = (j > 0) ? substr(s, j) : ""
			if (id == "") continue
			if (filter != "" && index(id, filter) == 0) continue
			printf "%s%s\n", ((body ~ /"image"/) ? "vision\t" : "text\t"), id
		}
	}'
	exit 0 ;;
attach)
	printf 'agent\timage\thow\n'
	for a in $agents; do
		case $a in
		pi | opencode | dsh) printf '%s\tyes\tmodel input\n' "$a" ;;
		claude | codex) printf '%s\tyes\tdirect\n' "$a" ;;
		grok) printf '%s\tyes\tviewer\n' "$a" ;;
		*) printf '%s\t?\tunknown\n' "$a" ;;
		esac
	done
	exit 0 ;;
esac

if [ "${1:-}" = acp ]; then
	shift
	acp_self=$0
	[ -L "$acp_self" ] && acp_self=$(readlink "$acp_self" 2>/dev/null && [ -n "$acp_self" ] || echo "$0")
	case $acp_self in
	/*) ;;
	*/*)
		acp_link=$0
		case $acp_link in
		*/*) acp_self=${acp_link%/*}/$acp_self ;;
		esac ;;
	esac
	case $acp_self in
	*/*) acp_dir=${acp_self%/*} ;;
	*) acp_dir=. ;;
	esac
	acp_dir=$(cd "$acp_dir" 2>/dev/null && pwd) || acp_dir=.
	acp_self=$acp_dir/$(basename "$acp_self")
	[ -f "$acp_self" ] && [ -r "$acp_self" ] || acp_self=$(command -v terat 2>/dev/null)
	acp_tmp=$(mktemp -d "${TMPDIR:-/tmp}/terat-acp.XXXXXX" 2>/dev/null) || acp_tmp=${TMPDIR:-/tmp}
	trap 'rm -rf "$acp_tmp"' EXIT INT TERM
	acp_awk=$acp_tmp/acp.awk
	acp_program() {
		cat <<'__TERAT_ACP_AWK__'
# The three JSON jobs the ACP bridge cannot do in sh. Embedded so that one file
# is the whole install.
#
# ACP is JSON-RPC; terat is sed and case statements. Between them the only hard
# parts are reading a field out of a request and writing a string back out safely.
# That is all this file is. The protocol lives in terat's `acp)` branch, where it
# can be read top to bottom: one case per method, one line per field.
#
# Modes, chosen with -v mode=:
#   get   print one field of the request on stdin, named by -v k=
#   text  print the text of every content block in a session/prompt
#   esc   escape stdin so it can sit inside a JSON string
#
# Deliberately not a parser. A real one is the interpreter dependency terat's
# install story exists to avoid, and every field read here is a top-level scalar.

# A top-level scalar, printed with its JSON type intact: a client that sends a
# numeric id must not get a quoted one back. An absent field prints nothing, which
# every caller reads as "not given".
function scalar(txt, k,   pat, raw) {
	pat = "\"" k "\"[ \t]*:[ \t]*\"([^\"\\\\]|\\\\.)*\""
	if (match(txt, pat)) {
		raw = substr(txt, RSTART, RLENGTH)
		sub("^\"" k "\"[ \t]*:[ \t]*", "", raw)
		return raw
	}
	pat = "\"" k "\"[ \t]*:[ \t]*[-0-9]+"
	if (match(txt, pat)) {
		raw = substr(txt, RSTART, RLENGTH)
		sub("^\"" k "\"[ \t]*:[ \t]*", "", raw)
		return raw
	}
	return ""
}

# A field as bare text: quotes stripped, escapes resolved. For a path or a value,
# where the JSON wrapper is noise.
function bare(txt, k,   v) {
	v = scalar(txt, k)
	if (substr(v, 1, 1) == "\"") v = substr(v, 2, length(v) - 2)
	gsub(/\\"/, "\"", v)
	gsub(/\\n/, "\n", v)
	gsub(/\\t/, "\t", v)
	gsub(/\\\\/, "\\", v)
	return v
}

BEGIN {
	if (mode == "esc") {
		# stdin is the whole question, and a question may hold a newline while a
		# JSON string may not, so it is read as one string and escaped.
		out = ""
		while ((getline line) > 0) out = out (out == "" ? "" : "\n") line
		if (out ~ /["\\\t\r\n]/) {
			res = ""
			n = length(out)
			for (i = 1; i <= n; i++) {
				c = substr(out, i, 1)
				if (c == "\\") res = res "\\\\"
				else if (c == "\"") res = res "\\\""
				else if (c == "\t") res = res "\\t"
				else if (c == "\r") res = res "\\r"
				else if (c == "\n") res = res "\\n"
				else res = res c
			}
			out = res
		}
		printf "%s", out
		exit 0
	}
}

mode == "get" {
	printf "%s", bare($0, k)
	next
}

# The JSON-RPC id, kept exactly as it arrived. Ids are the one field whose type
# matters: a client that sent the string "abc" must get "abc" back, quoted, or
# the reply is not JSON at all - and a numeric id must not gain quotes either.
mode == "id" {
	printf "%s", scalar($0, "id")
	next
}

mode == "text" {
	# The prompt is an array of content blocks; joining the text ones is the whole
	# of what this bridge accepts. A question split across blocks is one question.
	rest = $0
	while (match(rest, "\"text\"[ \t]*:[ \t]*\"")) {
		rest = substr(rest, RSTART + RLENGTH)
		v = ""
		open = 1
		while (open && rest != "") {
			c = substr(rest, 1, 1)
			rest = substr(rest, 2)
			if (c == "\\") { v = v c substr(rest, 1, 1); rest = substr(rest, 2) }
			else if (c == "\"") open = 0
			else v = v c
		}
		gsub(/\\"/, "\"", v)
		gsub(/\\n/, "\n", v)
		gsub(/\\t/, "\t", v)
		gsub(/\\\\/, "\\", v)
		printf "%s\n", v
	}
}
__TERAT_ACP_AWK__
	}
	acp_program >"$acp_awk"

	if [ -t 0 ]; then
		printf 'terat: acp speaks JSON-RPC on stdin, so it is for a client, not a prompt\n' >&2
		printf 'terat: to ask about acp: terat "what is acp"\n' >&2
		exit 2
	fi

	acp_n=0
	acp_esc() {
		printf '%s' "$1" | awk -v mode=esc -f "$acp_awk"
	}
	acp_get() {
		printf '%s' "$2" | awk -v mode=get -v k="$1" -f "$acp_awk"
	}
	acp_get_id() {
		printf '%s' "$1" | awk -v mode=id -f "$acp_awk"
	}
	acp_reply() {
		printf '{"jsonrpc":"2.0","id":%s,"result":%s}\n' "$1" "$2"
	}
	acp_error() {
		printf '{"jsonrpc":"2.0","id":%s,"error":{"code":%s,"message":"%s"}}\n' \
			"$1" "$2" "$(acp_esc "$3")"
	}
	acp_no_session() {
		printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32002,"message":"unknown session","data":{"sessionId":"%s"}}}\n' \
			"$1" "$(acp_esc "$2")"
	}
	acp_var() {
		eval "printf '%s' \"\${acp_$1_$2:-}\""
	}
	acp_known() {
		case " $acp_sessions " in
		*" $1 "*) [ -n "$1" ] ;;
		*) return 1 ;;
		esac
	}
	acp_sessions=''
	acp_inited=''
	exec 4<&0
	: >"$acp_tmp/pending"
	acp_next() {
		acp_got=''
		if [ -s "$acp_tmp/pending" ]; then
			acp_line=$(awk 'NR == 1' "$acp_tmp/pending")
			awk 'NR > 1' "$acp_tmp/pending" >"$acp_tmp/pending.new" 2>/dev/null &&
				mv "$acp_tmp/pending.new" "$acp_tmp/pending"
			acp_got=1
		elif IFS= read -r acp_line; then
			acp_got=1
		fi
		[ -n "$acp_got" ]
	}

	while acp_next; do
		case $acp_line in
		*[![:space:]]*) ;;
		*) continue ;; # a blank line carries nothing
		esac
		acp_id=$(acp_get_id "$acp_line")
		acp_method=$(acp_get method "$acp_line")
		if [ -z "$acp_inited" ] && [ "$acp_method" != initialize ]; then
			if [ -n "$acp_method" ]; then
				acp_error "${acp_id:-null}" -32600 'initialize must come first'
			else
				acp_error "${acp_id:-null}" -32700 'not a JSON-RPC request'
			fi
			continue
		fi
		case $acp_method in
		'')
			acp_error "${acp_id:-null}" -32700 'not a JSON-RPC request' ;;
		initialize)
			acp_inited=1
			acp_reply "$acp_id" '{"protocolVersion":1,"agentCapabilities":{"loadSession":false,"promptCapabilities":{},"sessionCapabilities":{}},"authMethods":[{"id":"terat-config","name":"terat set","description":"Configure the endpoint with terat set url/key."}],"agentInfo":{"name":"terat","title":"terat","version":"'"$terat_version"'"}}' ;;
		session/new)
			acp_where=$(acp_get cwd "$acp_line")
			if [ -z "$acp_where" ]; then
				acp_error "$acp_id" -32602 'session/new needs a cwd'
				continue
			fi
			acp_n=$((acp_n + 1))
			acp_sid=sess_$acp_n
			acp_sessions="$acp_sessions $acp_sid"
			eval "acp_dir_$acp_sid=\$acp_where"
			acp_m=$(cfg_get model)
			acp_opts=''
			acp_vals=''
			acp_url=$(cfg_get url)
			if [ -n "$acp_url" ] && command -v curl >/dev/null 2>&1; then
				acp_list=$(curl -s -m 8 "$acp_url/models" 2>/dev/null | tr -d '\n\r' |
					awk '{
							s = $0
							while ((i = index(s, "\"id\":")) > 0) {
								s = substr(s, i + 5)
								sub(/^[ \t]*"/, "", s)
								n = index(s, "\"")
								if (n == 0) break
								printf "%s\n", substr(s, 1, n - 1)
								s = substr(s, n + 1)
							}
						}' 2>/dev/null)
				for _am in $acp_list; do
					acp_opts="$acp_opts${acp_opts:+,}{\"value\":\"$(acp_esc "$_am")\",\"name\":\"$(acp_esc "$_am")\"}"
					acp_vals="$acp_vals $_am"
				done
			fi
			case " $acp_vals " in
			*" $acp_m "*) ;;
			*) [ -n "$acp_m" ] && acp_vals="$acp_vals $acp_m" && acp_opts="${acp_opts:+,}{\"value\":\"$(acp_esc "$acp_m")\",\"name\":\"$(acp_esc "$acp_m")\"}" ;;
			esac
			[ -n "$acp_opts" ] || acp_opts='{"value":"default","name":"default"}'
			[ -n "$acp_vals" ] || acp_vals=' default'
			acp_m=${acp_m:-default}
			eval "acp_vals_$acp_sid=\$acp_vals"
			acp_agent_now=$(acp_var agent "$acp_sid")
			[ -n "$acp_agent_now" ] || acp_agent_now=$(cfg_get agent)
			acp_agent_now=${acp_agent_now:-pi}
			acp_aopts=''
			for _aa in $agents; do
				acp_aopts="$acp_aopts${acp_aopts:+,}{\"value\":\"$_aa\",\"name\":\"$_aa\"}"
			done
			acp_reply "$acp_id" "{\"sessionId\":\"$acp_sid\",\"configOptions\":[{\"type\":\"select\",\"id\":\"model\",\"category\":\"model\",\"name\":\"Model\",\"currentValue\":\"$(acp_esc "$acp_m")\",\"options\":[$acp_opts]},{\"type\":\"select\",\"id\":\"_agent\",\"category\":\"_agent\",\"name\":\"Agent\",\"currentValue\":\"$(acp_esc "$acp_agent_now")\",\"options\":[$acp_aopts]}],\"modes\":{\"currentModeId\":\"ask\",\"availableModes\":[{\"id\":\"ask\",\"name\":\"Ask\",\"description\":\"One question, one answer.\"}]}}" ;;
		session/set_config_option)
			acp_sid=$(acp_get sessionId "$acp_line")
			acp_cfg=$(acp_get configId "$acp_line")
			acp_val=$(acp_get value "$acp_line")
			if ! acp_known "$acp_sid"; then
				acp_no_session "$acp_id" "$acp_sid"
			elif [ "$acp_cfg" = _agent ]; then
				case " $agents " in
				*" $acp_val "*)
					[ -n "$acp_val" ] || { acp_error "$acp_id" -32602 'no value'; continue; }
					eval "acp_agent_$acp_sid=\$acp_val"
					acp_aopts=''
					for _aa in $agents; do
						acp_aopts="$acp_aopts${acp_aopts:+,}{\"value\":\"$_aa\",\"name\":\"$_aa\"}"
					done
					acp_reply "$acp_id" "{\"configOptions\":[{\"type\":\"select\",\"id\":\"_agent\",\"category\":\"_agent\",\"name\":\"Agent\",\"currentValue\":\"$(acp_esc "$acp_val")\",\"options\":[$acp_aopts]}]}" ;;
				*) acp_error "$acp_id" -32602 "no such agent: $acp_val" ;;
				esac
			elif [ "$acp_cfg" != model ]; then
				acp_error "$acp_id" -32602 "no such config option: $acp_cfg"
			elif [ -z "$acp_val" ]; then
				acp_error "$acp_id" -32602 'no value'
			else
				case " $(acp_var vals "$acp_sid") " in
				*" $acp_val "*)
					eval "acp_model_$acp_sid=\$acp_val"
					acp_reply "$acp_id" "{\"configOptions\":[{\"type\":\"select\",\"id\":\"model\",\"category\":\"model\",\"name\":\"Model\",\"currentValue\":\"$(acp_esc "$acp_val")\"}]}" ;;
				*) acp_error "$acp_id" -32602 "unsupported value for model: $acp_val" ;;
				esac
			fi ;;
		session/set_mode)
			acp_sid=$(acp_get sessionId "$acp_line")
			acp_val=$(acp_get modelId "$acp_line")
			if ! acp_known "$acp_sid"; then
				acp_no_session "$acp_id" "$acp_sid"
			elif [ -z "$acp_val" ]; then
				acp_val=$(acp_get modeId "$acp_line")
				if [ "$acp_val" = ask ]; then
					acp_reply "$acp_id" '{}'
				else
					acp_error "$acp_id" -32602 "no such mode: $acp_val"
				fi
			else
				eval "acp_model_$acp_sid=\$acp_val"
				acp_reply "$acp_id" '{}'
			fi ;;
		session/prompt)
			acp_sid=$(acp_get sessionId "$acp_line")
			if ! acp_known "$acp_sid"; then
				acp_no_session "$acp_id" "$acp_sid"
				continue
			fi
			acp_where=$(acp_var dir "$acp_sid")
			acp_q=$(printf '%s' "$acp_line" | awk -v mode=text -f "$acp_awk")
			if [ -z "$acp_q" ]; then
				acp_error "$acp_id" -32602 'no text content in prompt'
				continue
			fi
			acp_mdl=$(acp_var model "$acp_sid")
			[ -n "$acp_mdl" ] || acp_mdl=$(cfg_get model)
			acp_agn=$(acp_var agent "$acp_sid")
			[ -n "$acp_agn" ] || acp_agn=$(cfg_get agent)
			acp_reply_q=$(acp_esc "$acp_q")
			printf '{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"%s","update":{"sessionUpdate":"user_message_chunk","content":{"type":"text","text":"%s"}}}}\n' "$acp_sid" "$acp_reply_q"
			acp_outf=$acp_tmp/ans.$$
			acp_errf=$acp_tmp/err.$$
			acp_pidf=$acp_tmp/pid.$$
			(
				cd "$acp_where" 2>/dev/null || cd .
				if [ -n "$acp_agn" ] && [ -n "$acp_mdl" ]; then
					printf '%s\n' "$acp_q" | TERAT_ACP_AGENT=$acp_agn TERAT_ACP_MODEL=$acp_mdl "$acp_self"
				elif [ -n "$acp_agn" ]; then
					printf '%s\n' "$acp_q" | TERAT_ACP_AGENT=$acp_agn "$acp_self"
				elif [ -n "$acp_mdl" ]; then
					printf '%s\n' "$acp_q" | TERAT_ACP_MODEL=$acp_mdl "$acp_self"
				else
					printf '%s\n' "$acp_q" | "$acp_self"
				fi
			) >"$acp_outf" 2>"$acp_errf" &
			acp_child=$!
			printf '%s' "$acp_child" >"$acp_pidf"

			acp_cancelled=''
			while kill -0 "$acp_child" 2>/dev/null; do
				rm -f "$acp_tmp/line.$$"
				( IFS= read -r acp_l <&4 2>/dev/null && printf '%s\n' "$acp_l" >"$acp_tmp/line.$$" ) &
				acp_rdr=$!
				acp_w=0
				while [ "$acp_w" -lt 10 ] && kill -0 "$acp_rdr" 2>/dev/null &&
					kill -0 "$acp_child" 2>/dev/null; do
					sleep 0.1 2>/dev/null || sleep 1
					acp_w=$((acp_w + 1))
				done
				kill "$acp_rdr" 2>/dev/null
				wait "$acp_rdr" 2>/dev/null
				if [ -f "$acp_tmp/line.$$" ]; then
					acp_more=$(cat "$acp_tmp/line.$$" 2>/dev/null)
					rm -f "$acp_tmp/line.$$"
					case $acp_more in
					*session/cancel*)
						acp_csid=$(acp_get sessionId "$acp_more")
						if [ -n "$acp_csid" ] && [ "$acp_csid" != "$acp_sid" ]; then
							printf '%s\n' "$acp_more" >>"$acp_tmp/pending"
							continue
						fi
						acp_cancelled=1
						kill "$acp_child" 2>/dev/null
						acp_w=0
						while kill -0 "$acp_child" 2>/dev/null && [ "$acp_w" -lt 30 ]; do
							sleep 0.1 2>/dev/null || sleep 1
							acp_w=$((acp_w + 1))
						done
						kill -9 "$acp_child" 2>/dev/null
						break ;;
					*)
						printf '%s\n' "$acp_more" >>"$acp_tmp/pending" ;;
					esac
				fi
			done
			wait "$acp_child" 2>/dev/null
			acp_rc=$?
			acp_ans=$(cat "$acp_outf" 2>/dev/null)
			acp_said=$(cat "$acp_errf" 2>/dev/null)
			rm -f "$acp_outf" "$acp_errf" "$acp_pidf"
			if [ -n "$acp_cancelled" ]; then
				acp_reply "$acp_id" '{"stopReason":"cancelled"}'
				continue
			fi
			if [ "$acp_rc" -ne 0 ]; then
				if [ -n "$acp_said" ]; then
					acp_error "$acp_id" -32000 "$(printf '%s' "$acp_said" | head -3 | tr '\n' ' ')"
				else
					acp_error "$acp_id" -32000 "the agent failed (exit $acp_rc)"
				fi
				continue
			fi
			printf '{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"%s","update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"%s"}}}}\n' "$acp_sid" "$(acp_esc "$acp_ans")"
			acp_reply "$acp_id" '{"stopReason":"end_turn"}' ;;
		session/cancel)
			acp_reply "$acp_id" '{}' ;;
		authenticate | logout)
			acp_reply "$acp_id" '{}' ;;
		*)
			[ -n "$acp_id" ] && acp_error "$acp_id" -32601 "method not found: $acp_method" ;;
		esac
	done
	exit 0
fi

