	unset _carry
	for _a in $pi_cmd; do
		if [ "$_a" = '{}' ]; then
			[ -n "${_carry+x}" ] && set -- "$@" "$_carry"
			_carry="$prompt"
		elif [ -n "${_carry+x}" ]; then
			set -- "$@" "$_carry"
			unset _carry
			set -- "$@" "$_a"
		else
			set -- "$@" "$_a"
		fi
	done
	[ -n "${_carry+x}" ] && set -- "$@" "$_carry"
	exec "$@"
}
ctx_attached=''
[ -s "$tmp.attach" ] && ctx_attached=1
{
	printf 'Question: %s\n' "$q"
	printf '\n--- context, for reference only; already true, do not act on it ---\n'
	here
	[ -s "$thread" ] && {
		printf 'Shell history (commands already run, output already shown):\n'
		tail -n 200 "$thread" | clean
		printf '\n'
	}
