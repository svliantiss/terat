spin() {
	case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
	*[Uu][Tt][Ff]*8*) frames='⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏' ;;
	*) frames='- \ | /' ;;
	esac
	spin_draw '\033[?25l'
	while kill -0 "$pid" 2>/dev/null; do
		for f in $frames; do
			sleep 0.1 2>/dev/null || sleep 1
