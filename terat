#!/bin/sh
# terat - ask an AI one question and print the answer.
#
#   terat "why did that build fail?"
#   terat @shot.png "what is this?"
#   printf 'why?\n' | terat
#
#   terat claude "why did that build fail?"   ask another agent, once
#   terat set agent claude                    make it the default
#   terat set url | key | model               where it points, and with what
#   terat models [name]                       what the endpoint serves
#   terat attach                              how each agent takes an image
#   terat config                              show the settings, key redacted
#
# In zsh with terat.zsh loaded, `@` on a line switches the prompt into ask mode.

# One transcript per shell. TERAT_THREAD is set by terat.zsh, but a shell started
# before that line existed would not have it, so fall back to the parent's pid
# rather than one shared file: that is what mixed two terminals into one
# conversation. $$ is terat itself, always fresh, so it cannot stand in.
# HOME can be unset (cron, `env -u HOME`, a stripped container). Falling back to
# the current directory keeps the transcript working instead of trying to create
# /.terat and printing a mkdir error at exit.
thread=${TERAT_THREAD:-${HOME:-.}/.terat/thread.$PPID}
# How many seconds of *silence with no tool running* count as wedged. Not a
# limit on how long a question may take: a tool that keeps working is allowed to
# keep working, so a half-hour soak test is fine. pi streams deltas while the
# model generates, so real quiet is the abnormal case; 180 is far above the ~5s
# gap measured during a long generation and far below anything a person would
# wait on a dead run.
max=${TERAT_MAX:-180}
# Where the spinner is drawn while waiting: `below` (the default) gives it its
# own line under the question, `inline` puts it on the question's line.
spin_style=${TERAT_SPIN:-below}
# TMPDIR is not to be trusted: it can name a directory that does not exist, or
# one that cannot be written. Picking a temp dir that cannot hold a file used to
# fail on the first `>` with "Permission denied" and no answer at all, so test
# writability and fall back rather than assume.
tmp_base=${TMPDIR:-/tmp}
[ -d "$tmp_base" ] && [ -w "$tmp_base" ] || tmp_base=/tmp
tmp=$tmp_base/terat.$$
# When the question was asked, in milliseconds. Only used for tracing, and only
# when the answer stream carries no timestamps of its own — a plain-text harness
# has none, so without this the root span would claim to have taken no time.
#
# Sub-second precision where the platform has it. `date +%s` alone rounds to a
# second, which reports most questions as 0ms; a `date` that ignores %N (busybox,
# older BSD) echoes the suffix back, so that is detected and falls back to whole
# seconds instead of storing nonsense.
now_ms() {
	_terat_t=$(date +%s%N 2>/dev/null)
	case $_terat_t in
	''|*[!0-9]*) _terat_t=$(date +%s 2>/dev/null)
		case $_terat_t in ''|*[!0-9]*) _terat_t=0 ;; esac
		_terat_t=$((_terat_t * 1000)) ;;
	*) _terat_t=$((_terat_t / 1000000)) ;;
	esac
	printf '%s' "$_terat_t"
}
started=$(now_ms)
mkdir -p "${thread%/*}" 2>/dev/null

# pi works natively here: same tools, same permissions, same default prompt as
# running `pi` yourself — it can create files, run commands, read the project.
# This script is only the transport: it adds the transcript and question, and
# prints what comes back. `--no-tools` was never right: it left the model unable
# to do the thing being asked while still claiming to be an agent.
#
# `-p` runs once and prints, which is what a prompt wants. Left as a plain
# answer, though, it cannot be told when the agent has finished: pi prints its
# last line and then lingers, so the old code guessed from a pause in the output
# and killed it ~4s later. That is fatal for real work, where a tool call (a
# build, a search) is silent for far longer than an answer. `--mode json` emits
# `agent_end` when the agent is genuinely done, so the wait is exact instead of
# guessed, and no run is cut off in the middle of doing something.
# --- agents and settings ---------------------------------------------------
#
# `terat claude` asks claude instead of pi; `terat set agent claude` makes that
# the default. Settings live in one file, because the six agents do not agree on
# anything: two take a URL and key from the environment, two want a config
# directory, one wants `-c` overrides, two read a file whose path they let you
# move. That difference is a table here and nowhere else — a wrapper script per
# agent, or a `case` scattered through the run, is the version that rots.
#
# Verified against the real binaries rather than read off help text:
#   claude    ANTHROPIC_BASE_URL, ANTHROPIC_API_KEY
#   grok      GROK_BASE_URL, GROK_API_KEY, GROK_MODEL
#   opencode  OPENCODE_CONFIG_DIR -> opencode.json
#   codex     -c key=value overrides
#   pi        PI_CODING_AGENT_DIR -> models.json, settings.json
#   dsh       DSH_HOME -> profiles/headless/cordis.patch.yml
terat_cfg=${TERAT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/terat/settings}
agents='pi claude codex opencode grok dsh'

# One row per agent: how to ask it a question on stdin, and what to call it over
# the answer. `{}` marks where the question goes for the two that refuse stdin.
agent_cmd() {
	case $1 in
	pi) echo 'pi -p --mode json' ;;
	claude) echo 'claude -p' ;;
	codex) echo 'codex exec --skip-git-repo-check' ;;
	opencode) echo 'opencode run' ;;
	grok) echo 'grok -p {}' ;;
	dsh) echo 'dsh --profile headless {}' ;;
	*) return 1 ;;
	esac
}

agent_name() {
	case $1 in
	pi) echo Pi ;;
	claude) echo Claude ;;
	codex) echo Codex ;;
	opencode) echo opencode ;;
	grok) echo Grok ;;
	dsh) echo dsh ;;
	*) return 1 ;;
	esac
}

# A name that names an agent, rather than a question about one.
is_agent() { agent_cmd "$1" >/dev/null 2>&1; }

# Read one key. Last line wins, so a key written twice behaves the same whether
# it got there by `terat set` or by hand.
cfg_get() {
	[ -f "$terat_cfg" ] || return 0
	awk -v k="$1" '
		index($0, k "=") == 1 { v = substr($0, length(k) + 2) }
		END { if (v != "") print v }
	' "$terat_cfg"
}

# Write one key, dropping any previous line for it. Through a temp file and a
# rename: an interrupted write must not leave a half-written config behind.
cfg_set() {
	mkdir -p "${terat_cfg%/*}" 2>/dev/null
	# `END` still has to run when the file is missing, which is the first write:
	# awk exits 2 on a file it cannot open and never reaches END, so an absent
	# file is fed as empty input instead. Without this the first `terat set`
	# printed its confirmation and saved nothing.
	if [ -f "$terat_cfg" ]; then
		cfg_in=$terat_cfg
	else
		cfg_in=/dev/null
	fi
	awk -v k="$1" -v v="$2" '
		index($0, k "=") == 1 { next }
		{ print }
		END { print k "=" v }
	' "$cfg_in" >"$terat_cfg.new" || return 1
	mv "$terat_cfg.new" "$terat_cfg" || return 1
	chmod 600 "$terat_cfg" 2>/dev/null
	return 0
}

# Subcommands. Both run before anything reads stdin, and neither talks to an
# agent: they write a file and exit, which is what makes them safe in a script.
case ${1:-} in
set)
	shift
	key=${1:-}
	[ "$#" -gt 0 ] && shift
	val=$*
	case $key in
	agent)
		if [ -z "$val" ]; then
			cur=$(cfg_get agent)
			printf '%s\n' "${cur:-pi (default)}"
			exit 0
		fi
		if ! is_agent "$val"; then
			printf 'terat: no such agent: %s\n' "$val" >&2
			printf 'terat: try %s\n' "$agents" >&2
			exit 2
		fi
		cfg_set agent "$val" || exit 1
		# Say whether it can actually run, so a typo lands here rather than at
		# the next question. Not fatal: installing the agent is the next step.
		bin=$(agent_cmd "$val" | awk '{print $1}')
		if command -v "$bin" >/dev/null 2>&1; then
			printf 'agent=%s\n' "$val"
		else
			printf 'agent=%s (but `%s` is not on PATH yet)\n' "$val" "$bin"
		fi
		exit 0 ;;
	url | key | model)
		if [ -z "$val" ]; then
			# A key is never printed: it is read by an agent, not by a person,
			# and a terminal keeps what it shows in scrollback.
			case $key in
			key)
				if [ -n "$(cfg_get key)" ]; then printf 'key=(set)\n'
				else printf 'key=(unset)\n'
				fi ;;
			*) printf '%s=%s\n' "$key" "$(cfg_get "$key")" ;;
			esac
			exit 0
		fi
		cfg_set "$key" "$val" || exit 1
		case $key in key) printf 'key=(set)\n' ;; *) printf '%s=%s\n' "$key" "$val" ;; esac
		exit 0 ;;
	'')
		printf 'terat: set what?\n' >&2
		printf 'terat: set agent %s\n' "$agents" >&2
		printf 'terat: set url <base url>\n' >&2
		printf 'terat: set key <api key>\n' >&2
		printf 'terat: set model <model id>   (terat models shows them)\n' >&2
		exit 2 ;;
	*)
		printf 'terat: cannot set: %s\n' "$key" >&2
		printf 'terat: try agent, url, key or model; terat models lists them\n' >&2
		exit 2 ;;
	esac ;;
config)
	if [ -f "$terat_cfg" ]; then
		sed 's/^key=.*/key=(set)/' "$terat_cfg"
	else
		printf 'terat: no settings yet; %s does not exist\n' "$terat_cfg"
	fi
	exit 0 ;;
agents)
	printf '%s\n' $agents
	exit 0 ;;
models)
	# `shift` first: inside this branch $1 is the word `models`, so a filter
	# read from $1 would always be the literal "models" and match nothing.
	shift
	# What the endpoint serves, so a model can be named rather than guessed.
	# Reads the router's own list, which needs no key — so this works before
	# `terat set key` and cannot leak what it does not have. One id per line,
	# with `vision` first when the server says the model takes images: that
	# distinction changes the answer, and is the reason terat writes `input`
	# into the configs it generates.
	url=$(cfg_get url)
	[ -n "$url" ] || { printf 'terat: no endpoint yet; terat set url <url>\n' >&2; exit 2; }
	json=$(curl -s -m 20 "$url/models" 2>/dev/null) ||
		wget -q -T 20 -O - "$url/models" 2>/dev/null || {
		printf 'terat: could not read %s/models\n' "${url%/}" >&2
		exit 1
	}
	[ -n "$json" ] || { printf 'terat: %s/models returned nothing\n' "${url%/}" >&2; exit 1; }
	printf '%s' "$json" | tr -d '\n\r' | awk -v filter="${1:-}" '
	{
		s = $0
		while ((i = index(s, "\"id\":")) > 0) {
			s = substr(s, i + 5)
			sub(/^[ \t]*"/, "", s)
			n = index(s, "\"")
			if (n == 0) break
			id = substr(s, 1, n - 1)
			s = substr(s, n + 1)
			# The record ends where the next one begins; splitting there keeps
			# a nested object from being read as part of this model.
			j = index(s, "\"id\":")
			body = (j > 0) ? substr(s, 1, j - 1) : s
			s = (j > 0) ? substr(s, j) : ""
			if (id == "") continue
			if (filter != "" && index(id, filter) == 0) continue
			printf "%s%s\n", ((body ~ /"image"/) ? "vision\t" : "text\t"), id
		}
	}'
	exit 0 ;;
# Whether an image can reach the model is a property of the pair, not of either
# half: a vision model behind a harness that reads files as bytes answers about
# the bytes. All six handle it now, but not the same way, so this says which
# mechanism does the work rather than repeating "yes" six times.
attach)
	printf 'agent\timage\thow\n'
	for a in $agents; do
		case $a in
		# Reads the path with its own tool and attaches the file as an image
		# block. Gated on the model entry declaring `input` — the field terat
		# writes into the config it generates, and the reason it writes it.
		pi | opencode | dsh) printf '%s\tyes\tmodel input\n' "$a" ;;
		# Attaches whatever it is told to read; no capability field involved.
		claude | codex) printf '%s\tyes\tdirect\n' "$a" ;;
		# Passes the file through its own viewer, which renders images.
		grok) printf '%s\tyes\tviewer\n' "$a" ;;
		*) printf '%s\t?\tunknown\n' "$a" ;;
		esac
	done
	exit 0 ;;
config)
	if [ -f "$terat_cfg" ]; then
		sed 's/^key=.*/key=(set)/' "$terat_cfg"
	else
		printf 'terat: no settings yet; %s does not exist\n' "$terat_cfg"
	fi
	exit 0 ;;
agents)
	printf '%s\n' $agents
	exit 0 ;;
models)
	# `shift` first: inside this branch $1 is the word `models`, so a filter
	# read from $1 would always be the literal "models" and match nothing.
	shift
	# What the endpoint serves, so a model can be named rather than guessed.
	# Reads the router's own list, which needs no key — so this works before
	# `terat set key` and cannot leak what it does not have. One id per line,
	# with `vision` first when the server says the model takes images: that
	# distinction changes the answer, and is the reason terat writes `input`
	# into the configs it generates.
	url=$(cfg_get url)
	[ -n "$url" ] || { printf 'terat: no endpoint yet; terat set url <url>\n' >&2; exit 2; }
	json=$(curl -s -m 20 "$url/models" 2>/dev/null) ||
		wget -q -T 20 -O - "$url/models" 2>/dev/null || {
		printf 'terat: could not read %s/models\n' "${url%/}" >&2
		exit 1
	}
	[ -n "$json" ] || { printf 'terat: %s/models returned nothing\n' "${url%/}" >&2; exit 1; }
	printf '%s' "$json" | tr -d '\n\r' | awk -v filter="${1:-}" '
	{
		s = $0
		while ((i = index(s, "\"id\":")) > 0) {
			s = substr(s, i + 5)
			sub(/^[ \t]*"/, "", s)
			n = index(s, "\"")
			if (n == 0) break
			id = substr(s, 1, n - 1)
			s = substr(s, n + 1)
			# The record ends where the next one begins; splitting there keeps
			# a nested object from being read as part of this model.
			j = index(s, "\"id\":")
			body = (j > 0) ? substr(s, 1, j - 1) : s
			s = (j > 0) ? substr(s, j) : ""
			if (id == "") continue
			if (filter != "" && index(id, filter) == 0) continue
			printf "%s%s\n", ((body ~ /"image"/) ? "vision\t" : "text\t"), id
		}
	}'
	exit 0 ;;
# Which agent can pass an image through, as measured rather than assumed. The
# capability is a property of the pair, not of either half: a vision model behind
# an agent that reads files as bytes answers about the bytes, and an agent that
# can attach will not help a text-only model. Asking for the matrix is cheaper
# than discovering it one failed screenshot at a time.
attach)
	# Reads the file as the agent's own tool would, then reports whether the
	# bytes reached a model at all.
	printf 'agent\timage\n'
	for a in $agents; do
		case $a in
		# Both bundle the same library and honour `input` for a model entry, so
		# they attach an image when the model declares it can take one.
		pi | opencode | dsh) printf '%s\tconfig\n' "$a" ;;
		# claude and codex hand the file to the model directly and are not
		# gated on a capability field; measured reading a known image.
		claude | codex) printf '%s\tyes\n' "$a" ;;
		# No image path: a PNG arrives as IDAT bytes and the model answers
		# about those. Verified by asking it to open one.
		*) printf '%s\tno\n' "$a" ;;
		esac
	done
	exit 0 ;;
esac

# Which agent answers this question. The command line beats the saved default:
# `terat set agent claude` is what you normally want, and `terat grok "…"` is
# how you ask one question of something else.
agent=$(cfg_get agent)
agent=${agent:-pi}
# `--` ends the options, so everything after it is the question. Needed because
# ask mode sends the question as argv words: without this, asking "claude wrote
# this" would select the claude agent and lose the word.
if [ "${1:-}" = '--' ]; then
	shift
else
	case ${1:-} in
	'' | -*) ;; # no question yet, or a flag rather than a name
	*)
		# Only with a question behind it. `terat claude` alone asks the
		# configured agent about claude; it is not a request to ask claude
		# nothing, and the word must not be shifted away and lost.
		if is_agent "$1" && [ "$#" -gt 1 ]; then
			agent=$1
			shift
		fi ;;
	esac
fi

# Settings only matter if they reach the agent, and each agent is reached
# differently. This is all of that difference.
cfg_url=$(cfg_get url)
cfg_key=$(cfg_get key)
cfg_model=$(cfg_get model)
if [ -n "$cfg_url$cfg_key$cfg_model" ]; then
	# The model is a command-line flag for the agents that spell one and a field
	# in the generated file for the two that do not. Sending it as an env var
	# only worked for grok, which is how this was found: claude quietly fell back
	# to its own default and asked the router for a model it does not serve.
	case $agent in
	claude)
		# claude appends /v1/messages to this itself, so a base that already
		# ends in /v1 asks it for /v1/v1/messages and the answer comes back as
		# "may not exist or you may not have access to it", which reads like a
		# bad model id and sends you looking in the wrong place.
		[ -n "$cfg_url" ] && export ANTHROPIC_BASE_URL=${cfg_url%/v1}
		[ -n "$cfg_url" ] && export ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL%/}
		[ -n "$cfg_key" ] && export ANTHROPIC_API_KEY=$cfg_key
		[ -n "$cfg_model" ] && model_arg="--model $cfg_model" ;;
	grok)
		[ -n "$cfg_url" ] && export GROK_BASE_URL=$cfg_url
		[ -n "$cfg_key" ] && export GROK_API_KEY=$cfg_key
		[ -n "$cfg_model" ] && model_arg="-m $cfg_model" ;;
	pi)
		# pi reads providers from models.json inside an agent dir it lets you
		# move, so the settings become that file. Nothing is written into a
		# real ~/.pi: a working hand-written setup is left exactly as it was.
		# `input` is not cosmetic. A model entry without it is text-only as far
		# as pi is concerned, so read drops the image from the request and the
		# answer says the model cannot see pictures — even for a model that can.
		pdir=${TMPDIR:-/tmp}/terat.$agent.$$
		# The generated file holds the key, so it must not be readable by
		# everyone. `>` takes the umask, which is normally 022 — the settings
		# file is 600, and a temp file with the same secret should match it.
		umask 077
		mkdir -p "$pdir" 2>/dev/null
		printf '{"providers":{"terat":{"baseUrl":"%s","api":"openai-completions","apiKey":"%s","models":[{"id":"%s","input":["text","image"]}]}}}\n' \
			"${cfg_url:-http://127.0.0.1:1/v1}" "${cfg_key:-none}" "${cfg_model:-none}" \
			>"$pdir/models.json" 2>/dev/null
		printf '{"defaultProvider":"terat","defaultModel":"%s"}\n' "${cfg_model:-none}" \
			>"$pdir/settings.json" 2>/dev/null
		[ -n "$cfg_model" ] && model_arg="--model $cfg_model"
		PI_CODING_AGENT_DIR=$pdir
		export PI_CODING_AGENT_DIR
		terat_generated=$pdir ;;
	opencode)
		odir=${TMPDIR:-/tmp}/terat.$agent.$$
		umask 077
		mkdir -p "$odir" 2>/dev/null
		# Same lesson as pi, different spelling: without `modalities` opencode
		# treats the model as text-only and refuses to attach the file.
		printf '{"$schema":"https://opencode.ai/config.json","provider":{"terat":{"npm":"@ai-sdk/openai-compatible","name":"terat","options":{"baseURL":"%s","apiKey":"%s"},"models":{"%s":{"name":"%s","modalities":{"input":["text","image"]}}}}},"model":"terat/%s"}\n' \
			"${cfg_url:-http://127.0.0.1:1/v1}" "${cfg_key:-none}" \
			"${cfg_model:-none}" "${cfg_model:-none}" "${cfg_model:-none}" \
			>"$odir/opencode.json" 2>/dev/null
		OPENCODE_CONFIG_DIR=$odir
		export OPENCODE_CONFIG_DIR
		terat_generated=$odir ;;
	codex)
		# codex has no config-dir variable in this build, but it does take
		# `-c key=value`, which is a real interface: a file in ~/.codex would
		# mean editing someone else's config.
		extra=''
		[ -n "$cfg_url" ] && extra="$extra -c model_providers.terat.base_url=$cfg_url"
		[ -n "$cfg_key" ] && extra="$extra -c model_providers.terat.env_key=TERAT_KEY"
		[ -n "$cfg_model" ] && extra="$extra -c model=$cfg_model"
		extra="$extra -c model_providers.terat.name=terat -c model_providers.terat.wire_api=responses"
		[ -n "$cfg_url" ] && extra="$extra -c model_provider=terat"
		[ -n "$cfg_key" ] && { TERAT_KEY=$cfg_key; export TERAT_KEY; }
		codex_extra=$extra ;;
	dsh)
		# dsh names an env var rather than holding a key, and the variable has to
		# be exported for the child to see it. Same shape as the profile patch
		# this repo already tests against: `apiKeyEnv`, not a literal `apiKey`.
		ddir=${TMPDIR:-/tmp}/terat.$agent.$$
		umask 077
		mkdir -p "$ddir/profiles/headless" 2>/dev/null
		# `input` matters here for the same reason it does in pi's models.json:
		# dsh bundles the same library and drops an image the model entry does not
		# claim, so without it the answer says the model cannot see pictures.
		printf -- '- id: llm-pi-ai\n  config:\n    providers:\n      terat:\n        displayName: terat\n        apiKeyEnv: TERAT_KEY\n        api: openai-completions\n        baseURL: %s\n        models:\n          - id: %s\n            name: %s\n            input: ["text", "image"]\n- id: agent-default-model\n  config:\n    provider: terat\n    model: %s\n' \
			"${cfg_url:-http://127.0.0.1:1/v1}" "${cfg_model:-none}" \
			"${cfg_model:-none}" "${cfg_model:-none}" \
			>"$ddir/profiles/headless/cordis.patch.yml" 2>/dev/null
		[ -n "$cfg_key" ] && { TERAT_KEY=$cfg_key; export TERAT_KEY; }
		DSH_HOME=$ddir
		export DSH_HOME
		terat_generated=$ddir ;;
	esac
fi

# The label and the command follow the agent, so `terat claude` says `Claude:`
# and `terat grok` puts the question where grok will read it.
TERAT_NAME=${TERAT_NAME:-$(agent_name "$agent")}
TERAT_AGENT=$agent
export TERAT_NAME TERAT_AGENT
# TERAT_CMD is the escape hatch and still wins: a caller who spelled a command
# out meant that command, and replacing it here would ignore them silently.
if [ -n "${TERAT_CMD:-}" ]; then
	pi_cmd=$TERAT_CMD
else
	pi_cmd="$(agent_cmd "$agent")${model_arg:+ $model_arg}${codex_extra:-}"
fi

# Some harnesses will not read the question from stdin: grok's -p demands it as
# an argument, and so does dsh in headless mode. Rather than make every such
# user write a wrapper script, `{}` in TERAT_CMD means "the question goes here".
# Without the placeholder the command is left exactly as given, so a harness
# that reads stdin needs to know nothing about this.
case $pi_cmd in
*'{}'*) q_in_argv=1 ;;
*) q_in_argv='' ;;
esac

# pi can be told what the transcript *is* rather than left to infer it. The
# question-first ordering above already stops past commands from being treated
# as requests, and this says it outright: a harness that runs a `cmd:` line from
# a previous turn does real damage, because those lines were real commands.
#
# Only the default command gets it. A caller who set TERAT_CMD chose a contract
# (question on stdin, answer on stdout) and may not accept extra flags; adding
# one behind their back would turn a working setup into "the harness exited 2".
terat_sys='You answer one question per run inside a terminal. The message is the
question first, then context that has already happened: the working directory,
shell history whose commands were already run, and files the user attached.
Lines beginning "cmd:" are history. Never re-run them. Do not run commands,
read files, or use tools unless the question itself asks for that. Answer the
question in as few lines as it needs and stop.'
# Passed as a real argument in run_harness, not glued onto $pi_cmd: that
# string is word-split, so a quoted phrase inside it would arrive mangled and
# a multi-line one would arrive in pieces.
# Only pi and claude take --append-system-prompt. Sending it to the others is
# not a degradation, it is a hard failure: codex exits 2 with "unexpected
# argument", so a first-class agent would look broken on its first question.
sys_ok=''
if [ -z "${TERAT_CMD:-}" ] && [ -z "$q_in_argv" ]; then
	case $agent in
	pi | claude) sys_ok=1 ;;
	esac
fi

# The one prerequisite: the agent itself. Said plainly, because the failure it
# causes is a shell error ("claude: not found") followed by "no answer", which
# reads like terat is broken rather than missing something to talk to. Only
# checked when we chose the command: TERAT_CMD is the caller's business, and a
# path that does not exist yet is a legitimate thing to test.
if [ -z "${TERAT_CMD:-}" ]; then
	bin=$(agent_cmd "$agent" | awk '{print $1}')
	if ! command -v "$bin" >/dev/null 2>&1; then
		printf 'terat: %s is not installed, and it is what answers the question\n' "$bin" >&2
		printf 'terat: install it, point TERAT_CMD at another harness, or ask a different agent: %s\n' "$agents" >&2
		exit 127
	fi
fi

# Trace propagation, off unless TERAT_TRACE_ID is set.
#
# pi does not emit W3C trace context, so without this the question, the model
# calls it causes and the router's own ledger are separate records that cannot
# be joined. Here the id is put on the request as `traceparent`; router reads
# that back into `requests.trace_id`, and the OTLP spans use the same id, so one
# value finds the whole thing.
#
# It is an extension loaded with -e, not a header in models.json, because pi
# treats a header that resolves to nothing as a fatal error: a static
# `${TERAT_*}` entry breaks every plain `pi` on a machine without those
# variables. Loaded this way it exists only for this run, and the extension
# returns immediately when the variables are absent.
# A traceparent is a fixed shape, and router takes whatever sits between the
# dashes as the id. A wrong length would be stored as a trace id that matches
# nothing and reads as a random string, so hold the value to 32 lowercase hex
# digits and drop the propagation entirely when it is not — asking for a trace
# with a bad id is a mistake worth ignoring, not a reason to fail the question.
trace_id=${TERAT_TRACE_ID:-}
# The directory holding a path, or the cwd for a bare name on PATH. Parameter
# expansion, not dirname(1): another binary to be missing, and on a stripped
# PATH it printed "dirname: not found" after the answer, reading as a failure.
dir_of() {
	case $1 in
	*/*) (cd "${1%/*}" 2>/dev/null && pwd) ;;
	*) pwd ;;
	esac
}

case $trace_id in
*[!0-9a-f]*) trace_id= ;;
esac
[ ${#trace_id} -eq 32 ] || trace_id=
if [ -n "$trace_id" ] && [ -z "${TERAT_CMD:-}" ]; then
	trace_span=${TERAT_TRACE_SPAN:-$(od -An -tx1 -N8 /dev/urandom 2>/dev/null | tr -d ' \n')}
	case $trace_span in
	????????????????) ;;
	*) trace_span=$(printf '%016x' $$) ;;
	esac
	trace_ext=$(dir_of "$0")/terat-trace.js
	if [ -f "$trace_ext" ]; then
		TERAT_TRACE_ID=$trace_id TERAT_TRACE_SPAN=$trace_span \
			export TERAT_TRACE_ID TERAT_TRACE_SPAN
		pi_cmd="$pi_cmd -e $trace_ext"
	fi
fi

# Attachments. A word starting with @ or # names a file or folder: pi receives
# it as an @file argument, and a folder is expanded to the files it holds
# because pi cannot read a directory. A word that names nothing stays part of
# the question, so "@nobody" is safe. In ask mode the zsh hook has already
# rejoined unquoted paths containing spaces, so what arrives here is one word.
: >"$tmp.files"
q=''
for a in "$@"; do
	case $a in
	@?* | '#'?*)
		p=${a#[@#]}
		case $p in "~") p=$HOME ;; "~"/*) p=$HOME${p#\~} ;; esac
		if [ -d "$p" ]; then
			find "$p" -maxdepth 1 -type f >>"$tmp.files" 2>/dev/null
		elif [ -f "$p" ]; then
			printf '%s\n' "$p" >>"$tmp.files"
		else
			q="$q $a"
		fi
		;;
	*) q="$q $a" ;;
	esac
done
q=${q# }
# A folder and a file inside it can both be named; keep one of each.
awk '!seen[$0]++' "$tmp.files" >"$tmp.uniq" 2>/dev/null
# Attachments are inlined rather than passed as @path arguments. Only some
# harnesses understand that syntax, and a path given to one that does not is
# silently useless: the model is told about a file it cannot open and answers
# about the path instead of the contents. Sending the bytes works everywhere and
# costs one read.
: >"$tmp.attach"
attach_total=0
while IFS= read -r f; do
	[ -n "$f" ] || continue
	size=$(wc -c <"$f" 2>/dev/null | tr -d ' ')
	size=${size:-0}
	# Binary would corrupt the context rather than inform it, so name it and
	# move on. A NUL byte in the first kilobyte is the portable test: `file` is
	# not everywhere and a MIME guess is wrong more often than it is right.
	if od -An -tx1 -N1024 "$f" 2>/dev/null | tr -d ' \n' | grep -q '00'; then
		printf 'File: %s (binary, %s bytes, not inlined)\n' "$f" "$size" >>"$tmp.attach"
		continue
	fi
	room=$(( ${TERAT_ATTACH_MAX:-200000} - attach_total ))
	if [ "$room" -le 0 ]; then
		printf 'File: %s (not inlined: attachment budget spent)\n' "$f" >>"$tmp.attach"
		continue
	fi
	printf 'File: %s\n' "$f" >>"$tmp.attach"
	head -c "$room" "$f" >>"$tmp.attach" 2>/dev/null
	attach_total=$((attach_total + size))
	[ "$size" -gt "$room" ] && printf '\n[... truncated at %s bytes]' "$room" >>"$tmp.attach"
	printf '\n\n' >>"$tmp.attach"
done <"$tmp.uniq"
rm -f "$tmp.files" "$tmp.uniq"

# `terat` with no question is just a shell: the same zsh you would otherwise
# start, which loads terat.zsh and with it the capture. Nothing is wrapped, so
# this is all of "normal mode". It has to come before the read below, which
# would otherwise block waiting for a question that is not coming.
if [ "$#" -eq 0 ] && [ -t 0 ] && [ -t 1 ]; then
	exec "${TERAT_SHELL_BIN:-/bin/zsh}" -l
fi

[ -z "$q" ] && IFS= read -r q
[ -z "$q" ] && [ "$#" -eq 0 ] && exit 0

# Output piped in is context. A shell cannot see what its own commands printed,
# so this is the one way to show it: `ls -l | terat "what is this?"`. With no
# question given, the first line of the pipe is the question instead.
out=''
if [ ! -t 0 ]; then
	if [ -n "$q" ]; then out=$(tail -n 200); else IFS= read -r q; fi
fi

# Stop the harness and any children it still has. Children are signalled first
# and the parent last, because killing the parent reparents them to init and
# they become unreachable by parent pid. Only one level deep is enough: the
# watchdog fires only when no tool is in flight (that is the condition it
# measures), so the tree is at most a shell wrapper and the command it ran.
# A Ctrl-C needs none of this — the terminal signals the whole foreground
# group, which includes the tool.
stop_child() {
	[ -n "${pid:-}" ] || return 0
	pkill -TERM -P "$pid" 2>/dev/null
	kill -TERM "$pid" 2>/dev/null
	sleep 0.2 2>/dev/null
	pkill -KILL -P "$pid" 2>/dev/null
	kill -KILL "$pid" 2>/dev/null
	return 0
}

# Every file this run may leave behind. Named once: the list was written out at
# each exit, and a file missing from one of them leaks.
tmp_files() {
	rm -f "$tmp" "$tmp.err" "$tmp.to" "$tmp.stop" "$tmp.stopped" "$tmp.attach" \
		"$tmp.files" "$tmp.uniq"
	# The agent's settings were rendered into a directory of their own for this
	# run. It holds a key, so it goes rather than being left in /tmp.
	[ -n "${terat_generated:-}" ] && rm -rf "$terat_generated" 2>/dev/null
	return 0
}

# A run that ends without an answer: keep the trace (an error is the run whose
# trace is worth having), clear up, fail.
give_up() {
	trace_ask
	tmp_files
	exit "${1:-1}"
}

# Clear the spinner and give the cursor back. Below, the whole line is ours, so
# `\r`+erase is right. Inline, the question is on that line and the cursor is on
# the frame itself, so erasing to the end of the line removes the frame and
# nothing else; a `\b` there would step back onto the question's last character.
# Then end the line, so the answer starts below the question rather than on it.
wipe() {
	[ -t 1 ] || return 0
	if [ "$spin_style" = inline ]; then
		printf '\033[K\n'
	else
		printf '\r\033[K'
	fi
	printf '\033[?25h'
}

bye() {
	stop_child
	kill "$watchdog" 2>/dev/null
	wipe
	tmp_files
	exit "$1"
}

trap 'bye 130' INT TERM

# Spin below the question, hide the cursor (it would sit on the frame), and
# Wait for the run to finish, not for a pause in the output. In json mode pi
# writes `agent_end` on one line when the agent is done, so this stops exactly
# then: a tool that is silent for a minute is just working, and is not mistaken
# for a finished answer. The spinner is drawn meanwhile.
spin() {
	case ${LC_ALL:-${LC_CTYPE:-${LANG:-}}} in
	*[Uu][Tt][Ff]*8*) frames='⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏' ;;
	*) frames='- \ | /' ;;
	esac
	[ -t 1 ] && printf '\033[?25l'
	while kill -0 "$pid" 2>/dev/null; do
		for f in $frames; do
			sleep 0.1 2>/dev/null || sleep 1
			kill -0 "$pid" 2>/dev/null || return 0
			# One cell either way. Inline prints the frame then steps back onto
			# it, so the next frame overwrites it and the question stays put;
			# starting with a `\b` would eat the question's last character.
			if [ "$spin_style" = inline ]; then
				[ -t 1 ] && printf '%s\b' "$f"
			else
				[ -t 1 ] && printf '\r%s ' "$f"
			fi
			# A run that ends without the marker (an error, an older pi)
			# must still stop, so fall back to the old quiet rule only once
			# the answer has gone quiet for a long time.
			if done_yet; then
				# Record that the stop was ours. A harness that does not
				# exit on its own (pi keeps its process alive after
				# agent_end) then dies by this signal, and `wait` returns
				# 143 — which must not be read as "the harness failed",
				# because it had already answered.
				: >"$tmp.stopped"
				stop_child
				return 0
			fi
		done
	done
}

# How many bytes have arrived so far. `wc -c <` on a missing file fails in the
# shell itself, so it is spelled once with the redirect and the trim.
arrived() {
	_n=$(wc -c <"$tmp" 2>/dev/null | tr -d ' ')
	printf '%s' "${_n:-0}"
}

# Has the agent finished? In json mode `agent_end` is the only true signal.
done_yet() {
	grep -q '"type":"agent_end"' "$tmp" 2>/dev/null && return 0
	# A json run without the marker is still going (or died); the watchdog
	# decides that, not a pause in the stream.
	grep -q '"type":"session"' "$tmp" 2>/dev/null && return 1
	size=$(arrived)
	[ "$size" -gt 0 ] || { last=0; g=0; return 1; }
	[ "$size" = "$last" ] || { last=$size; g=0; return 1; }
	g=$((g + 1))
	# g counts consecutive reads with no new bytes; reaching the grace count
	# is what "done" means. Comparing the other way ended the run on the first
	# quiet tick, which is 0.1s into a normal streamed answer.
	[ "$g" -ge "${TERAT_GRACE:-40}" ]
}

# Is a tool call still running? A `tool_execution_start` with no matching
# `tool_execution_end` after it. This is the whole reason a total timeout cannot
# work: `networkQuality` takes ~50 seconds, a soak test takes half an hour, and
# while either runs the stream is completely silent — indistinguishable from a
# stall by watching bytes alone, and impossible to fit under any fixed ceiling
# that also feels responsive.
#
# It is safe to trust because pi emits both events, always as a pair, and a
# killed run cannot leave a start without an end. Two tools at once would both
# be counted by a matched pair per start; pi runs them one at a time.
tool_busy() {
	[ -s "$tmp" ] || return 1
	s=$(grep -c '"type":"tool_execution_start"' "$tmp" 2>/dev/null)
	e=$(grep -c '"type":"tool_execution_end"' "$tmp" 2>/dev/null)
	[ "${s:-0}" -gt "${e:-0}" ]
}

# The model cannot see the screen, so it gets the two cheap facts that make
# "where is that file" and "clean up these screenshots" answerable: where this
# shell is, and what sits there. Bounded, so it never crowds out the thread.
#
# Visible names only, because that is what the person sees when they type `ls`
# and therefore what they mean by "those folders". dotfiles are not hidden from
# the model, only pushed down: a home directory holds hundreds of them and they
# would fill the list alphabetically before any real folder was named. A folder
# of nothing but dotfiles still gets listed.
here() {
	printf 'Where: %s\n' "$PWD"
	names=$(ls 2>/dev/null)
	[ -n "$names" ] || names=$(ls -A 2>/dev/null)
	[ -n "$names" ] || return 0
	total=$(printf '%s\n' "$names" | wc -l | tr -d ' ')
	names=$(printf '%s\n' "$names" | head -n "${TERAT_LIST:-20}" | tr '\n' ' ')
	names=${names% } # tr leaves one behind
	[ "$total" -gt "${TERAT_LIST:-20}" ] && names="$names... ($total in all)"
	printf 'Here: %s\n' "$names"
	printf '\n'
}

# A turn recorded before the system prompt was fixed may hold tool markup. Left
# in the transcript it teaches the next answer to do the same, so drop the whole
# turn rather than the tag: a half-turn would be read as an answer.
clean() {
	awk '
		/^user: / { if (block ~ /DSML|<\|.*\|>/) block = ""; printf "%s", block; block = $0 "\n"; next }
		{ block = block $0 "\n" }
		END { if (block !~ /DSML|<\|.*\|>/) printf "%s", block }
	'
}

# Run the harness. With `{}` in TERAT_CMD the question goes into the command
# line instead of stdin, because grok -p and dsh --profile headless both refuse
# to read it anywhere else; everything else keeps the plain pipe.
run_harness() {
	if [ -z "$q_in_argv" ]; then
		if [ -n "$sys_ok" ]; then
			$pi_cmd --append-system-prompt "$terat_sys"
		else
			$pi_cmd
		fi
		return
	fi
	# Build the argument list without eval: the question and the file contents
	# are arbitrary text, and word-splitting them would both mangle spaces and
	# execute anything that looked like shell syntax.
	prompt=$(cat)
	unset _carry
	for _a in $pi_cmd; do
		if [ "$_a" = '{}' ]; then
			# Two placeholders in a row would otherwise overwrite the first
			# instead of inserting it, quietly losing an argument.
			[ -n "${_carry+x}" ] && set -- "$@" "$_carry"
			_carry="$prompt"
		elif [ -n "${_carry+x}" ]; then
			set -- "$@" "$_carry"
			unset _carry
			set -- "$@" "$_a"
		else
			set -- "$@" "$_a"
		fi
	done
	# A trailing placeholder, or several: flush whatever is still pending.
	[ -n "${_carry+x}" ] && set -- "$@" "$_carry"
	exec "$@"
}
# The question comes first, and everything else follows it labelled as context.
#
# This is not cosmetic. The harness is an agent with a shell, and a transcript
# that opens with `cmd: rm -rf ...` reads like a request: measured against pi,
# a past command in that position was re-executed in roughly one run out of
# three. Putting the question first, and saying plainly that the rest has
# already happened, dropped that to zero in every trial. Order alone is not a
# guarantee, which is why the system prompt below repeats it.
ctx_attached=''
[ -s "$tmp.attach" ] && ctx_attached=1
{
	printf 'Question: %s\n' "$q"
	printf '\n--- context, for reference only; already true, do not act on it ---\n'
	here
	[ -s "$thread" ] && {
		printf 'Shell history (commands already run, output already shown):\n'
		tail -n 200 "$thread" | clean
		printf '\n'
	}
	[ -n "$out" ] && printf 'Output already on screen:\n%s\n\n' "$out"
	# The files the question refers to, inlined above, so that a harness with
	# no @file support is given the same information as one with it.
	[ -n "$ctx_attached" ] && { printf 'Attached files:\n'; cat "$tmp.attach"; }
} | run_harness >"$tmp" 2>"$tmp.err" &
pid=$!
# The watchdog measures silence, not total time, and a tool that is running does
# not count as silence.
#
# A total ceiling was wrong in both directions. Set to two minutes it killed a
# question that shelled out to a speedtest. Raised to ten it still killed a run
# that was asked for a half-hour soak test — the ceiling has to be shorter than
# a soak test to stay useful, so no value both accommodates long work and
# returns the prompt when something wedges.
#
# Silence with nothing in flight is different: measured across a long
# generation, the model streams deltas continuously and the longest genuine gap
# was about five seconds. So a few minutes of quiet with no tool running means
# the run is wedged, while any amount of quiet with a tool running is just work.
idle=0
(
	while [ ! -e "$tmp.stop" ]; do
		sleep 1
		if tool_busy; then
			idle=0
			continue
		fi
		size=$(arrived)
		if [ "$size" != "$wsize" ]; then
			wsize=$size
			idle=0
			continue
		fi
		idle=$((idle + 1))
		if [ "$idle" -ge "$max" ]; then
			# Mark first, then kill. The other order races: killing the
			# child wakes the main shell's `wait` immediately, and it can
			# reach the answer check and clean up before this subshell
			# gets to write the marker it is about to be judged by.
			: >"$tmp.to"
			stop_child
			break
		fi
	done
) >/dev/null 2>&1 &
watchdog=$!

spin
wait "$pid" 2>/dev/null
rc=$?
: >"$tmp.stop"
kill "$watchdog" 2>/dev/null
wait "$watchdog" 2>/dev/null
wipe

# The stream is json lines, one object per event. The answer is the text of the
# last assistant message that actually spoke: a turn that only called a tool has
# no text, and its markup must never be printed as if it were the reply.
answer() {
	awk '
		function unescape(s,   out, c2) {
			out = ""
			while (s != "") {
				c2 = substr(s, 1, 2)
				if (c2 == "\\n") { out = out "\n"; s = substr(s, 3); continue }
				if (c2 == "\\t") { out = out "\t"; s = substr(s, 3); continue }
				if (c2 == "\\\"") { out = out "\""; s = substr(s, 3); continue }
				if (c2 == "\\\\") { out = out "\\"; s = substr(s, 3); continue }
				if (substr(s, 1, 1) == "\"") break
				out = out substr(s, 1, 1); s = substr(s, 2)
			}
			return out
		}
		/"type":"message_end"/ && /"role":"assistant"/ {
			# One message may hold several content chunks; join every text
			# one and ignore tool calls, which carry arguments, not prose.
			rest = $0; text = ""
			while ((i = index(rest, "\"type\":\"text\",\"text\":\"")) > 0) {
				rest = substr(rest, i + 22)
				text = text unescape(rest)
				rest = substr(rest, 2)
			}
			if (text != "") last = text
		}
		# A plain-text run (an older pi, or TERAT_CMD) has no events: keep it.
		# grok-cli in headless mode writes the conversation as one
		# {"role":...,"content":...} object per line, which is the same
		# information in a different shape: take the last assistant line and
		# drop the envelope, so the answer is the answer and not a transcript.
		/^[[:space:]]*\{[[:space:]]*"role":"assistant"[[:space:]]*,[[:space:]]*"content":/ {
			i = index($0, "\"content\":\"")
			if (i > 0) {
				t = unescape(substr($0, i + 11))
				if (t != "") last = t
			}
			next
		}
		# Blank lines are spacing between events, not prose: counting them
		# would let a run that emitted nothing but separators look like a
		# plain-text answer
		# and win over the real one.
		NF && !/^[[:space:]]*\{[[:space:]]*"role":/ && !/^\{/ && !/^\}/ { plain = plain $0 "\n" }
		END { if (plain != "") printf "%s", plain; else if (last != "") printf "%s\n", last }
	'
}

# --- tracing ---------------------------------------------------------------
# Off unless TERAT_OTLP names an endpoint. The trace is built from the very
# event stream the answer came from, so it cannot disagree with what actually
# ran, and it is posted only after the answer is printed and only in the
# background: a slow or dead collector costs the prompt nothing.
#
# Defined here, above the answer checks, and called from the failure paths too:
# a run that errored or timed out is exactly the run whose trace is worth
# having, and for a while those were the only questions that left no trace at
# all.
trace_ask() {
	if [ -z "${TERAT_OTLP:-}" ] || [ ! -s "$tmp" ]; then
		return 0
	fi
	# Resolve the entry point before taking its directory: terat is normally
	# reached through ~/.local/bin/terat, and terat-trace.awk sits next to the
	# real script rather than next to the link. Getting this wrong drops every
	# trace silently, which is the worst way to lose them.
	self=$0
	[ -L "$self" ] && self=$(readlink "$self" 2>/dev/null) && [ -n "$self" ] || self=$0
	# Parameter expansion, not dirname(1): that is another binary to be missing.
	# On a stripped PATH it printed "dirname: not found" after the answer had
	# already been printed, which reads as a failure when nothing failed.
	trace_dir=$(dir_of "$self")
	[ -f "$trace_dir/terat-trace.awk" ] || trace_dir=.
	# Reuse the propagated id when there is one: the whole point of exporting
	# traceparent is that the spans and the router's ledger settle on one value,
	# so the trace must not mint a second id and quietly split them apart.
	trace=$trace_id
	[ -n "$trace" ] || trace=$(od -An -tx1 -N16 /dev/urandom 2>/dev/null | tr -d ' \n')
	case $trace in
	????????????????????????????????) ;;
	*) trace=$(printf '%08x%08x%08x%08x' $$ "$(date +%s)" 0 1) ;;
	esac
	body=$tmp_base/terat.trace.$$
	TERAT_TRACE_Q=$q TERAT_TRACE_A=$ans TERAT_TRACE_CWD=$PWD \
		awk -v trace="$trace" \
		-v seed="$(printf '%s' "$trace" | cut -c1-9)" \
		-v nowms="$(now_ms)" \
		-v began="$started" \
		-f "$trace_dir/terat-trace.awk" "$tmp" >"$body" 2>/dev/null
	if [ -s "$body" ] && command -v curl >/dev/null 2>&1; then
		auth=
		[ -n "${TERAT_OTLP_KEY:-}" ] && auth="Authorization: Bearer $TERAT_OTLP_KEY"
		# Off by default, because a trace is not worth a broken prompt. It also
		# does not go to stderr: this runs just after the answer, while the
		# prompt is being redrawn, so stray output would land in the middle of
		# it. A file is quiet and still says afterwards what went wrong.
		#   unset / 0 / no     nothing at all
		#   1 / yes / true     append to ${TMPDIR}/terat.otlp.log
		#   anything else      treat it as the log path
		dbg=
		case ${TERAT_OTLP_DEBUG:-} in
		'' | 0 | no | false) ;;
		1 | yes | true) dbg=$tmp_base/terat.otlp.log ;;
		*) dbg=$TERAT_OTLP_DEBUG ;;
		esac
		(
			# One request either way. The response is written to a file rather
			# than discarded so that the debugging branch can show it: a 400
			# body names the offending field, which is the whole reason for
			# turning the log on.
			code=$(curl -sS -m 10 -X POST "$TERAT_OTLP" \
				-H 'Content-Type: application/json' \
				${auth:+-H "$auth"} \
				--data-binary @"$body" \
				-o "$body.res" -w '%{http_code}' 2>"$body.err")
			if [ -n "$dbg" ]; then
				{
					printf '%s %s %s\n' \
						"$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" \
						"${code:-curl-failed}" "$TERAT_OTLP"
					# Kept short so the log stays readable when several
					# questions are being asked.
					[ -s "$body.res" ] && sed 's/^/  response: /' "$body.res" | head -5
					[ -s "$body.err" ] && sed 's/^/  stderr: /' "$body.err" | head -5
				} >>"$dbg" 2>/dev/null
			fi
			rm -f "$body.res" "$body.err" "$body"
		) &
	else
		rm -f "$body"
	fi
}

# Nothing at all came back: report why rather than printing an empty label.
if [ ! -s "$tmp" ]; then
	[ -s "$tmp.err" ] && head -5 "$tmp.err" >&2
	if [ -e "$tmp.to" ]; then
		printf 'terat: no output for %ss with no tool running, so the run looks stuck\n' "$max" >&2
	elif [ "$rc" -eq 0 ]; then
		# It ran, succeeded by its own account, and said nothing. That is what
		# a harness does when the model returns empty content, and saying
		# "no answer" without the exit code sends you looking in the wrong
		# place.
		printf 'terat: no answer (the harness exited 0 and printed nothing)\n' >&2
	else
		printf 'terat: no answer (the harness exited %s)\n' "$rc" >&2
	fi
	give_up
fi

ans=$(answer <"$tmp")
# A harness that pads its output is not starting the answer with whitespace.
# Blank lines before it are noise; the indentation of the first real line is
# not, because that is how a code block begins.
ans=$(printf '%s\n' "$ans" | awk 'f { print; next } NF { f = 1; print }')
# The label supplies one space, so do not add a second when the answer brings
# its own. The answer itself is printed exactly as it arrived.
label() {
	case ${ans%%[![:space:]]*} in
	'') printf '%s: %s\n' "${TERAT_NAME:-Pi}" "$ans" ;;
	*) printf '%s:%s\n' "${TERAT_NAME:-Pi}" "$ans" ;;
	esac
}

# A harness that exits non-zero did not answer. A CLI run by hand usually says
# why on stdout and exits 1 ("rate limited, retry later"); serving that as the
# answer is worse than saying the run failed, because it reads like the model
# replied. Keep the text, but mark it as what it is.
# Our own stop is not a failure: the harness had already answered and simply
# did not exit, which is normal for pi. Only a harness that failed on its own
# gets to have its complaint withheld.
if [ "$rc" -ne 0 ] && [ -n "$ans" ] && [ ! -e "$tmp.stopped" ]; then
	printf 'terat: the harness exited %s; it said:\n' "$rc" >&2
	printf '%s\n' "$ans" >&2
	give_up
fi

# Events came back but nobody spoke: the run failed, or it only used tools. Say
# so; do not print markup or an empty answer as though it were a reply.
if [ -z "$ans" ]; then
	# Say what the harness actually said. pi reports failures as a json event,
	# but any other command put behind TERAT_CMD just writes to stderr, and a
	# generic "no answer" hides a missing key or a bad flag behind a message
	# that looks like terat's fault. Its own words are more use than ours.
	# Pull just the message out of the error event. Printing the matched
	# fragment showed the user '"type":"error","message":"quota exceeded"',
	# which is the harness's wire format, not its words.
	msg=$(sed -n 's/.*"type":"error"[^}]*"message":"\([^"]*\)".*/\1/p' "$tmp" 2>/dev/null | head -1)
	# A provider that rejects the call puts its words in the assistant message's
	# own errorMessage, which the pattern above does not see: pi then ends the
	# turn with stopReason "error" and no text at all, and all the user learns is
	# "ended without a reply" while their key is the actual problem.
	if [ -z "$msg" ]; then
		msg=$(awk '
			/"errorMessage":"/ {
				i = index($0, "\"errorMessage\":\"") + 16
				rest = substr($0, i); out = ""
				while (rest != "") {
					c = substr(rest, 1, 2)
					if (c == "\\\"") { out = out "\""; rest = substr(rest, 3); continue }
					if (c == "\\\\") { out = out "\\"; rest = substr(rest, 3); continue }
					if (substr(rest, 1, 1) == "\"") break
					out = out substr(rest, 1, 1); rest = substr(rest, 2)
				}
				if (out != "") { print out; exit }
			}' "$tmp" 2>/dev/null)
	fi
	[ -n "$msg" ] || msg=$(grep -v '^[[:space:]]*$' "$tmp.err" 2>/dev/null | head -1)
	# Checked before the generic wording because a killed run answers nothing:
	# reporting "ended without a reply" for it sends you looking for a model
	# fault when the real cause was the clock, and TERAT_MAX is the fix.
	if [ -e "$tmp.to" ]; then
		printf 'terat: no output for %ss with no tool running, so the run looks stuck\n' "$max" >&2
	elif [ -n "$msg" ]; then
		printf 'terat: %s\n' "$msg" >&2
	else
		printf 'terat: no answer (the run ended without a reply)\n' >&2
	fi
	give_up
fi

# On a terminal the answer is labelled, so it cannot be mistaken for command
# output. Piped answers stay raw.
#
# The model writes prose as one very long line. A terminal does not wrap words,
# it cuts at the exact column, so a 600-character sentence comes back with
# "serve/rs" and "aga/in" split across lines and the left edge wandering. Break
# it at spaces to the width we actually have. `fold -s` only splits a word that
# is itself longer than the line, and leaves the short lines of a list or a code
# block alone.
if [ -t 1 ]; then
	# Read the size from the controlling terminal: `tput cols` inside $( ) sees
	# a pipe and answers 80, whatever the window really is, and an inherited
	# COLUMNS can be stale after a resize. The terminal itself is authoritative.
	cols=$(stty size </dev/tty 2>/dev/null | awk '{print $2}')
	[ -n "$cols" ] || cols=${COLUMNS:-}
	[ -n "$cols" ] || cols=$(tput cols 2>/dev/null)
	# A pty can report 0 columns before anything sets a size, and `fold -w 0`
	# is an error rather than a no-op.
	case $cols in ''|*[!0-9]*) cols=80 ;; esac
	[ "$cols" -ge 20 ] || cols=80
	# Below, the spinner sat on its own line and wipe cleared it, so the answer
	# needs a break to start under it. Inline, wipe already ended the question's
	# line; a second break here would leave a blank line between the two.
	[ "$spin_style" = inline ] || printf '\n'
	# The label is part of the first line, so folding it with the answer keeps
	# that line from running one label too wide. Stop a column short: a line
	# that fills the last column leaves the terminal holding a pending wrap,
	# and the newline then opens a blank line in the middle of the answer.
	# `fold` is external. In a pipeline its absence swallows the answer: the
	# pipe still runs, and nothing comes out the other end. Print unwrapped
	# instead — a long line is a cosmetic problem, a missing answer is not.
	if command -v fold >/dev/null 2>&1; then
		label | fold -s -w $((cols - 1))
	else
		label
	fi
else
	printf '%s\n' "$ans"
fi
printf 'user: %s\nassistant: %s\n' "$q" "$ans" >>"$thread"

# After the answer is on screen, so a slow collector delays nothing.
trace_ask
tmp_files
