#!/bin/sh
# terat-ask - the documented name for the in-place prompt. It is just `tert`.
#
# Kept because the docs, the Rex binding and older aliases call it terat-ask.

case $0 in
*/*) p=$0 ;;
*) p=$(command -v -- "$0" 2>/dev/null) || p=$0 ;;
esac
while [ -h "$p" ]; do
	d=$(cd -P "$(dirname "$p")" 2>/dev/null && pwd) || break
	p=$(readlink "$p" 2>/dev/null) || break
	case $p in
	/*) ;;
	*) p=$d/$p ;;
	esac
done
dir=$(cd -P "$(dirname "$p")" 2>/dev/null && pwd) || dir=.

exec "$dir/tert" "$@"
