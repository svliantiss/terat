#!/bin/sh
# terat - ask one question, get one answer on stdout.
#
#   printf 'what is 2+2\n' | terat
#
# POSIX sh and nothing else: no python, no jq, no zsh. The harness named in
# terat.conf does the talking (terat-curl by default, or beside this script if
# there is no config at all).
#
# The engine owns the conversation: it sends (thread + question) to the harness
# and appends the new turn only when the harness actually answered. Callers must
# NOT append history themselves, or every turn gets counted twice.

TERAT_DIR=${TERAT_DIR:-$HOME/.terat}
TERAT_CONF=${TERAT_CONF:-$HOME/.config/terat/terat.conf}
TERAT_ENV=${TERAT_ENV:-$HOME/.config/terat/env}
TERAT_THREAD_MAX=${TERAT_THREAD_MAX:-400} # lines of history kept as context

# --- where am I, through symlinks? ------------------------------------------
_terat_self() {
	case $0 in
	*/*) p=$0 ;;
	*) p=$(command -v -- "$0" 2>/dev/null) || p=$0 ;;
	esac
	while [ -h "$p" ]; do
		d=$(cd -P "$(dirname "$p")" 2>/dev/null && pwd) || break
		p=$(readlink "$p" 2>/dev/null) || break
		case $p in
		/*) ;;
		*) p=$d/$p ;;
		esac
	done
	cd -P "$(dirname "$p")" 2>/dev/null && pwd
}
TERAT_HOME=${TERAT_HOME:-$(_terat_self)}

# --- configuration ----------------------------------------------------------
# The env file is read here, not in your .zshrc, so terat works on a machine
# where nobody has ever sourced anything. Anything already exported in the
# environment wins over the file: `TERAT_MODEL=x terat` must mean x.
_terat_url=${TERAT_URL-}
_terat_key=${TERAT_KEY-}
_terat_model=${TERAT_MODEL-}
_terat_timeout=${TERAT_TIMEOUT-}
if [ -r "$TERAT_ENV" ]; then
	. "$TERAT_ENV"
fi
[ -n "$_terat_url" ] && TERAT_URL=$_terat_url
[ -n "$_terat_key" ] && TERAT_KEY=$_terat_key
[ -n "$_terat_model" ] && TERAT_MODEL=$_terat_model
[ -n "$_terat_timeout" ] && TERAT_TIMEOUT=$_terat_timeout
unset _terat_url _terat_key _terat_model _terat_timeout
[ -n "${TERAT_URL:-}" ] && export TERAT_URL
[ -n "${TERAT_KEY:-}" ] && export TERAT_KEY
[ -n "${TERAT_MODEL:-}" ] && export TERAT_MODEL
[ -n "${TERAT_TIMEOUT:-}" ] && export TERAT_TIMEOUT

# --- pick a harness from terat.conf ----------------------------------------
# Format:  name = command      (# comments and blank lines ignored)
# The first entry is the default; `terat name` picks another.
_terat_harness() {
	want=$1
	first=
	[ -r "$TERAT_CONF" ] || return 1
	while IFS= read -r line || [ -n "$line" ]; do
		case $line in
		'' | '#'*) continue ;;
		esac
		name=${line%%=*}
		cmd=${line#*=}
		name=$(printf '%s' "$name" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
		cmd=$(printf '%s' "$cmd" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
		[ -n "$name" ] || continue
		[ -n "$first" ] || first=$cmd
		if [ -n "$want" ] && [ "$name" = "$want" ]; then
			printf '%s\n' "$cmd"
			return 0
		fi
	done <"$TERAT_CONF"
	if [ -z "$want" ] && [ -n "$first" ]; then
		printf '%s\n' "$first"
		return 0
	fi
	return 1
}

q=$(cat)
[ -n "$q" ] || exit 0

mkdir -p "$TERAT_DIR" 2>/dev/null || {
	printf 'terat: cannot create %s\n' "$TERAT_DIR" >&2
	exit 1
}

if cmd=$(_terat_harness "${1:-}"); then
	:
elif [ -z "${1:-}" ] && [ -x "$TERAT_HOME/terat-curl" ]; then
	# No terat.conf at all: still works out of the box.
	cmd=$TERAT_HOME/terat-curl
else
	if [ -n "${1:-}" ]; then
		printf 'terat: no harness named %s in %s\n' "$1" "$TERAT_CONF" >&2
	else
		printf 'terat: no harness (looked in %s)\n' "$TERAT_CONF" >&2
	fi
	exit 1
fi

# --- build the prompt: kept history, then this question ---------------------
thread=$TERAT_DIR/thread
ctx=
if [ -s "$thread" ]; then
	ctx=$(tail -n "$TERAT_THREAD_MAX" "$thread" 2>/dev/null)
fi

prompt=$q
if [ -n "$ctx" ]; then
	prompt=$(printf '%s\n\nQuestion: %s\n' "$ctx" "$q")
fi

ans=$(printf '%s\n' "$prompt" | sh -c "$cmd")
status=$?

# Failure: say so on stderr, print nothing on stdout, leave the thread alone.
if [ "$status" -ne 0 ] || [ -z "$ans" ]; then
	printf 'terat: no answer from harness (exit %s)\n' "$status" >&2
	exit 1
fi

printf '%s\n' "$ans"

# --- record the turn --------------------------------------------------------
printf 'user: %s\nassistant: %s\n' "$q" "$ans" >>"$thread"
